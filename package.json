{
  "name": "systematlas",
  "version": "0.4.1",
  "description": "Visualize code flows authored by an LLM, at two altitudes (Flow + Sequence).",
  "type": "module",
  "license": "MIT",
  "author": "Todor Rusev <systematlas.dev@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/todor-rusev/systematlas.git"
  },
  "homepage": "https://github.com/todor-rusev/systematlas#readme",
  "bugs": {
    "url": "https://github.com/todor-rusev/systematlas/issues"
  },
  "keywords": [
    "flow",
    "sequence-diagram",
    "visualization",
    "diagram",
    "mcp",
    "llm",
    "cli"
  ],
  "bin": {
    "systematlas": "dist/cli.js",
    "sysatlas": "dist/cli.js",
    "systematlas-mcp": "dist/mcp.js"
  },
  "files": [
    "dist",
    "dist-renderer",
    "schema",
    "examples",
    "README.md",
    "THIRD-PARTY-NOTICES.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build:renderer": "vite build --mode singlefile",
    "build:cli": "tsup",
    "build": "npm run typecheck && npm run build:renderer && npm run build:cli",
    "preview": "vite preview",
    "mcp": "tsx src/mcp/server.ts",
    "cli": "tsx src/cli/index.ts",
    "demo:generate": "node --import tsx scripts/generate-visual-demo.mjs",
    "demo:check": "node --import tsx scripts/generate-visual-demo.mjs --check",
    "demo:build": "node dist/cli.js build examples/visual-demo --out docs --minify",
    "test": "node --import tsx --test src/core/*.test.ts src/sequence/*.test.ts src/mcp/*.test.ts src/*.test.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "chokidar": "^5.0.0",
    "semver": "^7.8.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.0",
    "@types/dagre": "^0.7.52",
    "@types/node": "^25.9.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@xyflow/react": "^12.3.5",
    "browserslist-to-esbuild": "^2.1.1",
    "dagre": "^0.8.5",
    "eslint": "^9.39.5",
    "eslint-plugin-baseline-js": "^0.7.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "tsx": "^4.22.4",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "browserslist": [
    "baseline widely available"
  ]
}
