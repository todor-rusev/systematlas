      "kind": "service"
    },
    {
      "id": "data",
      "label": "Данни",
      "kind": "infra"
    },
    {
      "id": "warehouse",
      "label": "Склад",
      "kind": "system"
    },
    {
      "id": "delivery",
      "label": "Куриер",
      "kind": "service"
    }
  ],
  "nodes": [
