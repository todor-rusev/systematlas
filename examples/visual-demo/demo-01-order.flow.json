{
  "$schema": "../../schema/flow.schema.json",
  "version": "1",
  "id": "demo-01-order",
  "title": "01 · Online shop order",
  "layout": "TB",
  "overview": [
    "A complete six-step process: a decision, a rejection, an asynchronous notification and two drill-downs into sub-processes (Payment also leads to a Sequence; the database and the queue live there)."
  ],
  "actors": [
    {
      "id": "customer",
      "label": "Customer",
      "kind": "human"
    },
    {
      "id": "shop",
      "label": "Online shop",
      "kind": "service"
    },
    {
      "id": "payment",
      "label": "Payments",
      "kind": "service"
    },
    {
      "id": "warehouse",
      "label": "Warehouse",
      "kind": "system"
    }
  ],
  "nodes": [
    {
      "id": "order",
      "type": "terminal",
      "label": "Customer orders",
      "owner": "customer",
      "description": [
        "The customer picks products and presses “Order”."
      ],
      "icon": {
        "kind": "builtin",
        "name": "user"
      }
    },
    {
      "id": "checkout",
      "type": "step",
      "label": "Cart and address",
      "owner": "shop",
      "description": [
        "The shop collects the cart, the address and the delivery method."
      ],
      "icon": {
        "kind": "builtin",
        "name": "browser"
      }
    },
    {
      "id": "pay",
      "type": "subflow",
      "label": "Payment",
      "owner": "payment",
      "description": [
        "Payment is a separate process: Open shows its steps."
      ],
      "subflow": "demo-02-payment",
      "icon": {
        "kind": "builtin",
        "name": "lock"
      }
    },
    {
      "id": "approved",
      "type": "decision",
      "label": "Approved?",
      "owner": "payment",
      "description": [
        "The payment result decides the path."
      ]
    },
    {
      "id": "declined",
      "type": "terminal",
      "label": "Declined",
      "owner": "customer",
      "description": [
        "The customer sees the reason and can try again."
      ],
      "icon": {
        "kind": "builtin",
        "name": "error"
      }
    },
    {
      "id": "fulfil",
      "type": "subflow",
      "label": "Warehouse and delivery",
      "owner": "warehouse",
      "description": [
        "Packing and delivery: Open shows the pictures of the process."
      ],
      "subflow": "demo-03-fulfilment",
      "icon": {
        "kind": "builtin",
        "name": "package"
      }
    },
    {
      "id": "mail",
      "type": "step",
      "label": "Email: order shipped",
      "owner": "shop",
      "description": [
        "Sent asynchronously; it does not hold up the process."
      ],
      "icon": {
        "kind": "builtin",
        "name": "mail"
      }
    },
    {
      "id": "done",
      "type": "terminal",
      "label": "Delivered",
      "owner": "customer",
      "description": [
        "The customer receives the parcel."
      ],
      "icon": {
        "kind": "builtin",
        "name": "check"
      }
    }
  ],
  "edges": [
    {
      "from": "order",
      "to": "checkout",
      "type": "flow"
    },
    {
      "from": "checkout",
      "to": "pay",
      "type": "flow"
    },
    {
      "from": "pay",
      "to": "approved",
      "type": "flow"
    },
    {
      "from": "approved",
      "to": "fulfil",
      "type": "branch",
      "label": "yes"
    },
    {
      "from": "approved",
      "to": "declined",
      "type": "branch",
      "label": "no"
    },
    {
      "from": "fulfil",
      "to": "done",
      "type": "flow"
    },
    {
      "from": "fulfil",
      "to": "mail",
      "type": "flow",
      "label": "async",
      "style": {
        "line": "dotted"
      }
    }
  ]
}
