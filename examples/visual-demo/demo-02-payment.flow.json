{
  "$schema": "../../schema/flow.schema.json",
  "version": "1",
  "id": "demo-02-payment",
  "title": "02 · Payment",
  "layout": "TB",
  "overview": [
    "The payment sub-process: a cache, rules, an external API with retry, a database and a queue."
  ],
  "actors": [
    {
      "id": "shop",
      "label": "Online shop",
      "kind": "service"
    },
    {
      "id": "payment",
      "label": "Payments",
      "kind": "service"
    },
    {
      "id": "data",
      "label": "Data",
      "kind": "infra"
    }
  ],
  "nodes": [
    {
      "id": "start",
      "type": "terminal",
      "label": "Amount to pay",
      "owner": "shop",
      "description": [
        "The amount and currency come from the cart."
      ],
      "icon": {
        "kind": "builtin",
        "name": "play"
      }
    },
    {
      "id": "token",
      "type": "step",
      "label": "Card token",
      "owner": "payment",
      "description": [
        "A saved token, so the card is not entered again."
      ],
      "shape": "cache",
      "icon": {
        "kind": "builtin",
        "name": "cache"
      }
    },
    {
      "id": "fraud",
      "type": "step",
      "label": "Fraud check",
      "owner": "payment",
      "description": [
        "Rules and limits before the request goes to the bank."
      ],
      "shape": "hex",
      "icon": {
        "kind": "builtin",
        "name": "shield"
      }
    },
    {
      "id": "gateway",
      "type": "step",
      "label": "Bank API",
      "owner": "payment",
      "description": [
        "Request to the payment provider; Open shows the exact calls."
      ],
      "shape": "api",
      "icon": {
        "kind": "builtin",
        "name": "api"
      },
      "sequence": "demo-18-execution"
    },
    {
      "id": "ok",
      "type": "decision",
      "label": "Success?",
      "owner": "payment",
      "description": [
        "The bank’s response."
      ]
    },
    {
      "id": "ledger",
      "type": "step",
      "label": "Ledger entry",
      "owner": "data",
      "description": [
        "The payment is recorded in the accounting database."
      ],
      "shape": "cyl",
      "icon": {
        "kind": "builtin",
        "name": "database"
      }
    },
    {
      "id": "events",
      "type": "step",
      "label": "Event queue",
      "owner": "data",
      "description": [
        "The “paid” event goes to the warehouse and accounting."
      ],
      "shape": "queue",
      "icon": {
        "kind": "builtin",
        "name": "queue"
      }
    },
    {
      "id": "end",
      "type": "terminal",
      "label": "Paid",
      "owner": "shop",
      "description": [
        "Returns to the main process."
      ],
      "icon": {
        "kind": "builtin",
        "name": "check"
      }
    }
  ],
  "edges": [
    {
      "from": "start",
      "to": "token",
      "type": "flow"
    },
    {
      "from": "token",
      "to": "fraud",
      "type": "flow"
    },
    {
      "from": "fraud",
      "to": "gateway",
      "type": "flow"
    },
    {
      "from": "gateway",
      "to": "ok",
      "type": "flow"
    },
    {
      "from": "ok",
      "to": "ledger",
      "type": "branch",
      "label": "yes"
    },
    {
      "from": "ok",
      "to": "gateway",
      "type": "return",
      "label": "retry"
    },
    {
      "from": "ledger",
      "to": "events",
      "type": "flow",
      "label": "async",
      "style": {
        "line": "dotted"
      }
    },
    {
      "from": "ledger",
      "to": "end",
      "type": "flow"
    }
  ]
}
