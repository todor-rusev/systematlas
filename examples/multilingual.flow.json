    { "id": "latin", "label": "Latin / Cyrillic", "kind": "service" },
    { "id": "cjk", "label": "Chinese / Japanese", "kind": "service" },
    { "id": "rtl", "label": "Arabic / Hebrew", "kind": "service" },
    { "id": "indic", "label": "Devanagari / Thai", "kind": "service" }
  ],
  "nodes": [
