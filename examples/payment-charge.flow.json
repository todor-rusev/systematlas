{
  "$schema": "../schema/flow.schema.json",
  "version": "2",
  "id": "payment-charge",
  "title": "Charge payment",
  "layout": "TB",
  "actors": [
    { "id": "api", "label": "Transaction API", "kind": "service" },
    { "id": "payment", "label": "Payment Gateway", "kind": "system" },
    { "id": "bank", "label": "Acquiring Bank", "kind": "system" }
  ],
  "nodes": [
    { "id": "start", "type": "terminal", "text": "Start", "details": "Entry point of the charge sub-flow." },
    {
      "id": "pc.authorize",
      "type": "step",
      "text": "Authorize",
      "owner": "payment",
      "details": "- Sends an authorization request to the gateway.\n- Reserves the amount on the card without capturing it yet.",
      "inputs": [{ "name": "amount", "type": "number" }, { "name": "card", "type": "Card" }],
      "source": { "file": "src/adapters/payment.ts", "symbol": "PaymentAdapter.authorize", "line": 64 }
    },
    {
      "id": "pc.bank",
      "type": "step",
      "text": "Bank authorization",
      "owner": "bank",
      "details": "Acquiring bank approves or rejects the authorization hold."
    },
    {
      "id": "pc.check",
      "type": "decision",
      "text": "authorized?",
      "owner": "payment",
      "details": "- Branches on the authorization outcome.\n- Transient failures are retried once."
    },
    {
      "id": "pc.capture",
      "type": "step",
      "text": "Capture funds",
      "owner": "payment",
      "details": "Captures the previously authorized amount.",
      "sequence": "charge-sequence",
      "source": { "file": "src/adapters/payment.ts", "symbol": "PaymentAdapter.capture", "line": 102 }
    },
    {
      "id": "pc.decline",
      "type": "step",
      "text": "Decline charge",
      "owner": "api",
      "details": "Marks the charge as declined and surfaces the reason."
    },
    {
      "id": "pc.result",
      "type": "io",
      "text": "ChargeResult",
      "owner": "api",
      "details": "The result emitted back to the parent flow before persistence.",
      "outputs": [{ "name": "chargeId", "type": "string" }, { "name": "status", "type": "ChargeStatus" }]
    },
    { "id": "done", "type": "terminal", "text": "Done", "details": "Sub-flow complete." }
  ],
  "edges": [
    { "from": "start", "to": "pc.authorize", "type": "flow" },
    { "from": "pc.authorize", "to": "pc.bank", "type": "flow" },
    { "from": "pc.bank", "to": "pc.check", "type": "flow" },
    { "from": "pc.check", "to": "pc.capture", "type": "branch", "text": "yes" },
    { "from": "pc.check", "to": "pc.decline", "type": "branch", "text": "no" },
    { "from": "pc.check", "to": "pc.authorize", "type": "return", "text": "retry once" },
    { "from": "pc.capture", "to": "pc.result", "type": "flow" },
    { "from": "pc.decline", "to": "pc.result", "type": "flow" },
    { "from": "pc.result", "to": "done", "type": "flow" }
  ]
}
